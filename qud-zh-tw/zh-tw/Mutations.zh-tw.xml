<?xml version="1.0" encoding="utf-8"?>

<mutations Lang="zh-tw" Encoding="utf-8">
  <category Name="Morphotypes" DisplayName="{{W|形態型}}">
    <mutation Name="Chimera" DisplayName="奇美拉">
      <description><p>你僅會顯現肉體突變，且在顯現新突變時的所有選項皆為肉體類。</p>
<br />
<p>每當你顯現一個新突變時，你的其中一個選項還會導致你隨機長出新的肢體。</p></description>
      <leveltext></leveltext>
    </mutation>
    <mutation Name="Esper" DisplayName="靈能者">
      <description><p>你僅會顯現精神突變，且在顯現新突變時，所有的突變選項皆為精神類。</p></description>
      <leveltext></leveltext>
    </mutation>
    <mutation Name="Unstable Genome" DisplayName="不穩定基因組">
      <description><p>每次購買此項時，你都會獲得一個額外的突變，但這些突變不會立即顯現。</p>
<p>每當你升級時，有 33% 的機率會導致你的基因組變得不穩定，並讓你從 3 個隨機突變中進行選擇。</p></description>
      <leveltext></leveltext>
    </mutation>
  </category>
  <category Name="Physical" DisplayName="{{G|肉體突變}}">
    <mutation Name="Adrenal Control" DisplayName="腎上腺控制" BearerDescription="那些能控制自己腎上腺的人">
      <description><p>你調節身體分泌腎上腺素的速度。</p></description>
      <leveltext><p>你可以增加身體的腎上腺素流動，持續 <stat Name="Duration" />。</p>
<p>在流動期間，你會獲得 +<stat Name="QuicknessBonus" /> 敏捷，且其他身體突變會獲得 +<stat Name="MutationBonus" Unit="等級" />。</p>
<statline Name="Cooldown" DisplayName="冷卻時間" /></leveltext>
    </mutation>
    <mutation Name="Beak" DisplayName="喙" BearerDescription="那些有喙的人">
      <description><p>你的臉看起來像個稍微有點特色的 <stat Name="BeakName" />。</p>
<br />
<p>+1 自我</p>
<p>你偶爾會啄向你的對手。</p>
<p><gametext>與 {{w|=faction:鳥=}} 的聲望 +200</gametext></p></description>
      <leveltext></leveltext>
    </mutation>
    <mutation Name="Burrowing Claws" DisplayName="挖掘爪" BearerDescription="掘地者">
      <description><p>你長著形似鏟子的利爪，可以挖掘穿透大地。</p></description>
      <leveltext><p><gametext>=weapon.Name=</gametext> 對牆壁的穿透力：<stat Name="WallPenetration" /></p>
<p><gametext>=weapon.Name|pluralize=</gametext> 在 <stat Name="WallHits" Unit="次穿透攻擊" /> 後摧毀牆壁。</p>
<switch Name="PrereleaseContent"><case Value="true"><p>非戰鬥狀態下可以挖掘向上或向下的通道</p></case></switch>
<p><gametext>=weapon.Name|pluralize= 也是一種 =weaponClass.name= 類型的天生武器，對非牆壁目標造成 <stat Name="Damage" /> 基礎傷害。</gametext></p></leveltext>
    </mutation>
    <mutation Name="Carapace" DisplayName="甲殼" BearerDescription="甲殼生物">
      <description><p>你受到耐用的甲殼保護。</p></description>
      <leveltext>
                    <p><stat Name="AV" Filters="signed" /> AV</p>
                    <p><stat Name="DV" Filters="signed" /> DV</p>
                    <p><stat Name="HeatResist" Filters="signed" /> Heat Resistance</p>
                    <p><stat Name="ColdResist" Filters="signed" /> Cold Resistance</p>
                    <switch Name="AddsRep"><case Value="" /><default><p><stat Name="AddsRep" /></p></default></switch>
                    <p>你可以收緊你的<stat Name="CarapaceName" /> to receive double the AV bonus at a -2 DV penalty as long as you remain still.</p>
                    <p>無法穿戴身體護甲。</p>
                </leveltext>
    </mutation>
    <mutation Name="Corrosive Gas Generation" DisplayName="腐蝕性氣體 生成" BearerDescription="那些驅逐 腐蝕性氣體 的人">
      <description><p>你在自身周圍釋放出爆發性的 <stat Name="GasName" />。</p></description>
      <leveltext><p>釋放氣體，持續 <stat Name="Duration" /></p>
<switch Name="LevelMatch">
<case Value="raise"><p>{{rules|提高 <stat Name="LevelEffectDescription" />}}</p></case>
<case Value="lower"><p>{{rules|降低 <stat Name="LevelEffectDescription" />}}</p></case>
</switch>
<statline Name="Cooldown" DisplayName="冷卻時間" /></leveltext>
    </mutation>
    <mutation Name="Double-muscled" DisplayName="雙重肌肉" BearerDescription="雙重肌肉的">
      <description><p>你擁有巨大的力量。</p></description>
      <leveltext><p>+<stat Name="Strength" /> 力量</p>
<p>近戰攻擊成功時，有 <stat Name="DazeChance" />% 的機率使對手眩暈 2-3 回合</p></leveltext>
    </mutation>
    <mutation Name="Electrical Generation" DisplayName="電力生成" BearerDescription="那些產生電力的人">
      <description><p>你會累積電荷，可以用來釋放並造成傷害。</p></description>
      <leveltext><p>最大充能：<stat Name="MaxCharge" /></p>
<p>每回合累積基礎 <stat Name="BaseChargePerTurn" /> 充能</p>
<p>可以釋放所有持有的充能，每 <stat Name="DischargeChunk" /> 充能造成 1d4 傷害</p>
<p>釋放的能量可以弧形傳導至鄰近目標並造成減損傷害，每 <stat Name="DischargeChunk" /> 充能最多可傳導至 1 個目標</p>
<p>EMP 會導致非自願性釋放（意志豁免難度 18）</p>
<switch Name="CanDrinkTransient">
    <case Value="true"><p>你可以從電力來源中汲取電荷。</p></case>
    <default><p>你可以從能量電池和電容器中汲取電荷。</p></default>
</switch>
<p>每受到 1 點電擊傷害，你就會獲得 <stat Name="DamageAbsorbFactor" /> 充能。</p>
<p>你可以為配備了整合電源的裝置提供充能。</p></leveltext>
    </mutation>
    <mutation Name="Electromagnetic Pulse" DisplayName="電磁脈衝" BearerDescription="會發射電磁脈衝的生物">
      <description><p>你產生一個電磁脈衝，使附近的器物與機器失效。</p></description>
      <leveltext><p>範圍：以自身為中心，面積為 <stat Name="Area" /></p>
<statline Name="Duration" DisplayName="Duration" />
<statline Name="Cooldown" DisplayName="冷卻時間" /></leveltext>
    </mutation>
    <mutation Name="Flaming Ray" DisplayName="火焰射線" BearerDescription="火焰之手的">
      <description>
                    <p>你發射出一道火焰光束<switch Name="BodyPartName"><case Value="" /><default> from your <stat Name="BodyPartName" /></default></switch>.</p>
                </description>
      <leveltext><p>向你選擇的方向發射一個 <stat Name="Range" />x<stat Name="Range" /> 的火焰光束。</p>
<statline Name="Damage" DisplayName="傷害" />
<statline Name="Cooldown" DisplayName="冷卻時間" />
<p>近戰攻擊會使敵人升溫 <stat Name="HeatOnHit" Unit="度" /></p></leveltext>
    </mutation>
    <mutation Name="Freezing Ray" DisplayName="冰凍射線" BearerDescription="凍手族">
      <description>
                    <p>你發射出一道寒霜光束<switch Name="BodyPartName"><case Value="" /><default> from your <stat Name="BodyPartName" /></default></switch>.</p>
                </description>
      <leveltext><p>向你選擇的方向發射一個 <stat Name="Range" />x<stat Name="Range" /> 的寒霜光束。</p>
<statline Name="Damage" DisplayName="傷害" />
<statline Name="Cooldown" DisplayName="冷卻時間" />
<p>近戰攻擊會使敵人降溫 <stat Name="CoolOnHit" Unit="度" /></p></leveltext>
    </mutation>
    <mutation Name="Heightened Hearing" DisplayName="聽覺敏銳" BearerDescription="聽覺敏銳的人">
      <description><p>你擁有超乎尋常的敏銳聽覺。</p></description>
      <leveltext><p>你能在 <stat Name="Radius" /> 半徑範圍內偵測到生物的存在。</p>
<switch Name="LevelMatch">
<case Value="true"><p>有機會辨識附近偵測到的生物</p></case>
<default><p>{{rules|增加辨識附近偵測到生物的機率}}</p></default>
</switch></leveltext>
    </mutation>
    <mutation Name="Heightened Quickness" DisplayName="敏捷度提升" BearerDescription="迅捷者">
      <description><p>你天生擁有驚人的速度。</p></description>
      <leveltext><p>+<stat Name="SpeedBonus" /> 敏捷</p></leveltext>
    </mutation>
    <mutation Name="Horns" DisplayName="角" BearerDescription="有角的">
      <description><p><gametext>=角.A.name.or.plural= 從你的頭上 =角.verb:jut= 出來。</gametext></p></description>
      <leveltext><p>近戰攻擊時有 20% 機率戳傷你的對手</p>
<statline Name="Damage" DisplayName="傷害增量" />
<statline Name="ToHitBonus" DisplayName="命中加成" />
<switch Name="LevelMode">
    <case Value="BleedBonus"><p>{{rules|增加流血豁免難度與強度}}</p></case>
    <case Value="LevelUp"><p>{{rules|增加流血豁免難度}}</p></case>
    <default><p>戳傷攻擊可能會導致流血</p></default>
</switch>
<p><gametext>=角.Name= =角.verb:are= 是一種短刃類型的天生武器。</gametext></p>
<p>+<stat Name="AV" /> AV</p>
<p>無法穿戴 頭盔</p>
<p><gametext>與 {{w|=faction:羚羊=}} 及 {{w|=faction:山羊族=}} 的聲望 +100</gametext></p></leveltext>
    </mutation>
    <mutation Name="Metamorphosis" DisplayName="蛻變" BearerDescription="形變者">
      <description><p>你變形成任何你觸碰過的生物形態。</p></description>
      <leveltext><p>僅能化身為等級低於或等於 <stat Name="MaxLevel" /> 的生物。</p>
<statline Name="Cooldown" DisplayName="冷卻時間" /></leveltext>
    </mutation>
    <mutation Name="Multiple Arms" DisplayName="多肢" BearerDescription="多臂的">
      <description><p>你擁有一組額外的手臂。</p></description>
      <leveltext><p>每當你進行一次近戰攻擊時，每隻額外的手臂都有 <stat Name="AttackChance" />% 的機率發動一次額外的近戰攻擊</p></leveltext>
    </mutation>
    <mutation Name="Multiple Legs" DisplayName="多足" BearerDescription="多足者">
      <description><p>你擁有一組額外的腿。</p></description>
      <leveltext><p>+<stat Name="MoveSpeed" /> 移動速度</p>
<p>+<stat Name="CarryCapacity" />% 負重能力</p></leveltext>
    </mutation>
    <mutation Name="Night Vision" DisplayName="夜視" BearerDescription="暗視者">
      <description><p>你在黑暗中視物。</p></description>
      <leveltext></leveltext>
    </mutation>
    <mutation Name="Phasing" DisplayName="相位移動" BearerDescription="相位移動者">
      <description><p>你可以短暫地穿透實體物。</p></description>
      <leveltext><statline Name="Duration" DisplayName="Duration" />
<statline Name="Cooldown" DisplayName="冷卻時間" /></leveltext>
    </mutation>
    <mutation Name="Photosynthetic Skin" DisplayName="光合作用皮膚" BearerDescription="綠皮膚的">
      <description><p>你透過強健的綠色皮膚吸收陽光來補充能量。</p></description>
      <leveltext><p>你可以透過沐浴陽光而非進食來獲得特殊的代謝效果，持續 <stat Name="DurationDay" Unit="天" />：自然療傷速率 +<stat Name="BonusRegen" /> 以及敏捷 (Quickness) +<stat Name="BonusQuickness" /></p>
<p>在陽光照射下，你會累積澱粉與木質素，可用於烹飪食物（每種最多 <stat Name="StarchServings" Unit="服務中的" /> 份）。</p>
<p>當位於植被相同的格位時，DV +<stat Name="BonusCamoflage" /></p>
<p>與 {{w|根系}}, {{w|樹木}}, {{w|藤蔓}} 以及 {{w|the 植物聯盟(Consortium of Phyta)}} 的聲望 +200</p></leveltext>
    </mutation>
    <mutation Name="Quills" DisplayName="Quills" BearerDescription="刺蝟族">
      <description><p>數以百計的針狀刺覆蓋著你的身體。</p></description>
      <leveltext><switch Name="LevelMatch">
    <case Value="true"><p><stat Name="MaxQuills" /> <stat Name="Quills" /></p></case>
    <default><p>+{{rules|80-120}} <stat Name="Quills" /></p></default>
</switch>
<p>可能會在自身周圍爆發式地噴射出 10% 的 <stat Name="Quills" /> (<gametext>=pv=<stat Name="QuillPen" /> =damage=<stat Name="QuillDamage" /></gametext>)</p>
<p>以每輪約 <stat Name="RegenRate" /> 的速率再生 <stat Name="Quills" /></p>
<p>只要保留一半以上的 <stat Name="Quills" />，即可獲得 +<stat Name="AV" /> AV（否則為 +<stat Name="AVWithPenalty" /> AV）</p>
<p>近戰攻擊你的生物可能會被你的 <stat Name="Quills" /> 刺穿，這會折斷大約 1% 的刺，且每折斷一根 <stat Name="Quill" /> 反彈 3% 的傷害。</p>
<p>無法穿戴身體護甲</p>
<p>免疫其他生物的 <stat Name="Quills" /></p></leveltext>
    </mutation>
    <mutation Name="Regeneration" DisplayName="再生" BearerDescription="那些具備再生能力的人">
      <description><p>你的傷口癒合得非常快。</p></description>
      <leveltext>
                    <p>您的全自然療癒率在戰鬥中依然有效。</p>
                    <p>+<stat Name="RegenBonus" />% faster natural healing rate</p>
                    <p><stat Name="RegenChance" />% chance to regrow a missing limb each round</p>
                    <switch Name="NoDecapitate">
                        <case Value="false" />
                        <default><p>{{rules|你不會被斬首。}}</p></default>
                    </switch>
                    <switch Name="LevelBelow5">
                        <case Value="true"><p><stat Name="DebuffChance" />% chance to remove a {{rules|minor physical debuff}} at random each round</p></case>
                        <default><p><stat Name="DebuffChance" />% chance to remove a {{rules|physical debuff}} at random each round</p></default>
                    </switch>
                </leveltext>
    </mutation>
    <mutation Name="Sleep Gas Generation" DisplayName="睡眠瓦斯生成" BearerDescription="那些排放 睡眠瓦斯 的人">
      <description><p>你在自身周圍釋放出爆發性的 <stat Name="GasName" />。</p></description>
      <leveltext><p>釋放氣體，持續 <stat Name="Duration" /></p>
<switch Name="LevelMatch">
<case Value="raise"><p>{{rules|增加的 <stat Name="LevelEffectDescription" />}}</p></case>
<case Value="lower"><p>{{rules|減少的 <stat Name="LevelEffectDescription" />}}</p></case>
<default></default>
</switch>
<statline Name="Cooldown" DisplayName="冷卻時間" /></leveltext>
    </mutation>
    <mutation Name="Slime Glands" DisplayName="黏液腺" BearerDescription="黏液噴射者">
      <description><p>你產生一種黏稠的黏液，可以吐向目標。</p>
<br />
<p>用黏液覆蓋一片區域</p>
<statline Name="Range" DisplayName="射程" />
<statline Name="Area" DisplayName="範圍" />
<statline Name="Cooldown" DisplayName="冷卻時間" />
<p>你可以直接走過黏液而不會滑倒。</p></description>
      <leveltext></leveltext>
    </mutation>
    <mutation Name="Spinnerets" DisplayName="紡絲器" BearerDescription="織網者">
      <description><p>你可以吐出黏性的絲網。</p></description>
      <leveltext><p>旋轉時，你會在移動路徑上留下蛛網。</p>
<switch Name="LevelMatch">
    <case Value="true"></case>
    <default><p>{{rules|增加蛛網強度}}</p></default>
</switch>
<statline Name="SpinDuration" DisplayName="Duration" Unit="移動動作" />
<saveline Name="MoveSave" />
<statline Name="Cooldown" DisplayName="冷卻時間" />
<p>你免疫被困住。</p>
<p>與 {{w|蛛形綱動物}} 的聲望 +300</p></leveltext>
    </mutation>
    <mutation Name="Stinger (Confusing Venom)" DisplayName="螫刺 (Confusing Venom)" BearerDescription="那些擁有帶有混亂毒素之螫刺的人">
      <description><p>你擁有一條帶有螫刺的尾巴，能向敵人注入 <stat Name="VenomType" /> 毒素。</p></description>
      <leveltext><p>近戰攻擊時有 20% 機率螫刺你的對手 (<gametext>=pv=<stat Name="StingerPen" /> =damage=<stat Name="StingerDamage" /></gametext>)</p>
<p>螫刺是長刃，且只能穿透一次。</p>
<p>衝鋒或突進時必定會觸發螫刺。</p>
<p>螫刺在造成傷害時會施加毒素（若 螫刺 是你的主武器，機率僅為 20%）。</p>
<p>可以使用「刺擊」主動技能來使用你的 螫刺 進行打擊，並自動命中且穿透。</p>
<statline Name="Cooldown" DisplayName="刺擊冷卻時間" />
<p>毒素會使對手混亂 <stat Name="Duration" /></p>
<p>+200 蛛形綱動物聲望</p></leveltext>
    </mutation>
    <mutation Name="Stinger (Paralyzing Venom)" DisplayName="螫刺 (Paralyzing Venom)" BearerDescription="那些帶有附著麻痺毒液之螫刺的人">
      <description><p>你擁有一條帶有螫刺的尾巴，能向敵人注入 <stat Name="VenomType" /> 毒素。</p></description>
      <leveltext><p>近戰攻擊時有 20% 機率螫刺你的對手 (<gametext>=pv=<stat Name="StingerPen" /> =damage=<stat Name="StingerDamage" /></gametext>)</p>
<p>螫刺是長刃，且只能穿透一次。</p>
<p>衝鋒或突進時必定會觸發螫刺。</p>
<p>螫刺在造成傷害時會施加毒素（若 螫刺 是你的主武器，機率僅為 20%）。</p>
<p>可以使用「刺擊」主動技能來使用你的 螫刺 進行打擊，並自動命中且穿透。</p>
<statline Name="Cooldown" DisplayName="刺擊冷卻時間" />
<p>毒素會使對手麻痺 <stat Name="Duration" /></p>
<p>+200 蛛形綱動物聲望</p></leveltext>
    </mutation>
    <mutation Name="Stinger (Poisoning Venom)" DisplayName="螫刺 (Poisoning Venom)" BearerDescription="那些擁有帶有中毒毒素之螫刺的人">
      <description><p>你擁有一條帶有螫刺的尾巴，能向敵人注入 <stat Name="VenomType" /> 毒素。</p></description>
      <leveltext><p>近戰攻擊時有 20% 的機率螫刺對手 <gametext>(=pv=<stat Name="StingerPen" /> =damage=<stat Name="StingerDamage" /></gametext>)</p>
<p>螫刺是一柄長刃，且只能穿透一次。</p>
<p>衝鋒或突進時必定會進行螫刺。</p>
<p>螫刺會在造成傷害時施加毒素（若 螫刺 是你的主要武器，機率僅為 20%）。</p>
<p>可以使用「螫刺」啟動技能，以你的 螫刺 進行打擊並自動命中且穿透。</p>
<statline Name="Cooldown" DisplayName="刺擊冷卻時間" />
<p>毒素會使對手中毒 <stat Name="Duration" /> (傷害增量 <stat Name="PoisonDamage" />)</p>
<p>與 {{w|蛛形綱動物}} 的聲望 +200</p></leveltext>
    </mutation>
    <mutation Name="Thick Fur" DisplayName="厚毛" BearerDescription="毛皮厚實的">
      <description><p>你全身覆蓋著一層厚厚的皮毛，能保護你免受惡劣環境的影響。</p>
<p></p>
<p>+5 耐熱</p>
<p>+5 耐寒</p>
<p>與 {{w|猿猴}}、{{w|狒狒}}、{{w|熊}} 以及 {{w|放牧享樂主義者}} 的聲望 +100</p></description>
      <leveltext></leveltext>
    </mutation>
    <mutation Name="Triple-jointed" DisplayName="三關節的" BearerDescription="三節關節的">
      <description><p>你的關節伸展幅度比平常大得多。</p></description>
      <leveltext><p>+<stat Name="Agility" /> 敏捷</p>
<p>使用衝刺與需要敏捷前置條件的技能時，有 <stat Name="Chance" />% 的機率不會進入冷卻時間</p></leveltext>
    </mutation>
    <mutation Name="Two-headed" DisplayName="雙頭" BearerDescription="雙頭的">
