<?xml version="1.0" encoding="utf-8"?>

<activatedabilities Lang="zh-tw" Encoding="utf-8">
  <ability Command="CommandAmputateLimb">
    <description>你切斷了自己的肢體，或是受感染同伴的肢體。</description>
  </ability>
  <ability Command="CommandFlyToggle">
    <description><p>您會掠過地面地形，且不會受到地面生物的近戰攻擊。</p>
              <br />
              <p>每一輪都有 <stat Name="CrashChance" />% 的機率墜落到地面。</p>
              <br />
              <p>您只能在地面上方飛行。</p></description>
  </ability>
  <ability Command="CommandSwoopAttack">
    <description><p>你俯衝攻擊地面上的目標，花費一回合進行攻擊，並花費一回合返回空中。</p>
<br />
<p>有 <stat Name="SwoopCrashChance" />% 的機率會撞擊地面（若你的攻擊被 盾牌 擋下，機率翻倍）。</p></description>
  </ability>
  <ability Command="CommandEndBurrowing">
    <description>你從洞穴中現身。</description>
  </ability>
  <ability Command="CommandEndDomination">
    <description>你停止支配這隻生物。</description>
  </ability>
  <ability Command="ShadeOilPhase">
    <description><p>你可以在短時間內穿透實體物。</p>
<br />
<statline Name="Duration" DisplayName="Duration" /></description>
  </ability>
  <ability Command="CommandEndSubmerged">
    <description>你從藏身處現身。</description>
  </ability>
  <ability Command="ActivateFabricateFromSelf">
    <description><switch Name="BatchSize">
                  <case Value="1"><p><gametext>你從 =fabricateSource= =fabricateVerb= =sample.a.name:single:asIfKnown=。</gametext></p></case>
                  <default><p><gametext>你從 =fabricateSource= =fabricateVerb= =sample.name:single:asIfKnown|pluralize=。</gametext></p></default>
              </switch>
              <br />
              <statline Name="BatchSize" DisplayName="批次大小" />
              <statline Name="HitpointsPer" DisplayName="每批生命值" />
              <statline Name="Cooldown" DisplayName="冷卻時間" /></description>
  </ability>
  <ability Command="CommandPlaceMine">
    <description><p>你放置了 <stat Name="MineAn" /> <stat Name="MineDisplayName" /> 地雷。</p>
<br />
<statline Name="MineTimer" DisplayName="計時器" Unit="回合" HideValue="-1" />
<statline Name="Cooldown" Unit="回合" DisplayName="冷卻時間" /></description>
  </ability>
  <ability Command="CommandRunOver">
    <description><p>你沿著直線衝刺，撞倒路徑上的生物。</p>
<br />
<statline Name="Damage" DisplayName="傷害" />
<statline Name="Range" DisplayName="範圍" />
<statline Name="Knockdown" DisplayName="擊倒豁免" />
<statline Name="Daze" DisplayName="眩暈豁免" /></description>
  </ability>
  <ability Command="CommandClone">
    <description>你複製了一個有機生物。</description>
  </ability>
  <ability Command="CommandTinkerTurret">
    <description><p>你在鄰近空間修補匠 =name= <stat Name="TurretName" />。</p>
<br />
<statline Name="Cooldown" DisplayName="冷卻時間" /></description>
  </ability>
  <ability Command="CommandEngulf">
    <description>你吞噬了相鄰的生物，將其活生生地吃掉，並可能吞噬更多。</description>
  </ability>
  <ability Command="CommandToggleAnchorSpikes">
    <description>你不會被物理手段強迫移動。</description>
  </ability>
  <ability Command="CommandToggleAnomalyFumigator">
    <description>你每回合都會釋放常態氣體雲。</description>
  </ability>
  <ability Command="CommandCathedraBlackOpal">
    <description><p>你撕裂時空，傳送到卡德中的隨機位置。</p>
<br />
<statline Name="Cooldown" DisplayName="冷卻時間" /></description>
  </ability>
  <ability Command="CommandCathedraRuby">
    <description><p>你在自己周圍產生一個火焰動力場，造成傷害並使物體著火，持續 3 回合。</p>
              <br />
              <statline Name="Area" DisplayName="範圍" />
              <statline Name="DamageRound1" DisplayName="第 1 回合傷害" />
              <statline Name="DamageRound2" DisplayName="第 2 回合傷害" />
              <statline Name="DamageRound3" DisplayName="第 3 回合傷害" />
              <statline Name="Cooldown" Unit="回合" DisplayName="冷卻時間" /></description>
  </ability>
  <ability Command="CommandCathedraSapphire">
    <description><p>你在自身周圍召喚一股衝擊力。生物會被從爆炸中心推開、陷入暈眩，並在最多 3 個增量內受到擠壓傷害。</p>
<br />
<statline Name="Area" DisplayName="範圍" />
<statline Name="DamageIncrement" DisplayName="傷害增量" />
<statline Name="Cooldown" Unit="回合" DisplayName="冷卻時間" /></description>
  </ability>
  <ability Command="CommandCathedraWhiteOpal">
    <description><p>你在自身周圍釋放出一陣閃光。</p>
<br />
<statline Name="Duration" Unit="回合" DisplayName="Duration" />
<statline Name="Cooldown" Unit="回合" DisplayName="冷卻時間" /></description>
  </ability>
  <ability Command="CommandToggleFireSuppressionSystem">
    <description>每當你處於火焰狀態時，每回合自動噴射阻燃膠。</description>
  </ability>
  <ability Command="CommandRecomposite">
    <description><p>你可以傳送至地圖上任何已探索過的區域。</p>
<br />
<statline Name="Cooldown" DisplayName="冷卻時間" /></description>
  </ability>
  <ability Command="CommandInflateAxons">
    <description><p>你獲得 +<stat Name="QuicknessBonus" /> 敏捷，持續 <stat Name="QuicknessDuration" /> 回合，隨後你會變得遲鈍，持續 10 回合。</p>
<br />
<statline Name="Cooldown" DisplayName="冷卻時間" /></description>
  </ability>
  <ability Command="CommandEmergencyRecomposite">
    <description><p>你傳送到地圖上隨機且已探索過的區域。</p>
<br />
<statline Name="Cooldown" DisplayName="冷卻時間" /></description>
  </ability>
  <ability Command="CommandToggleMedassistModule">
    <description><p>在適當情況下，會自動施用最多 8 個已裝填的注射器。</p>
<br />
<statline Name="Loadout" DisplayName="裝備配置" /></description>
  </ability>
  <ability Command="CommandToggleCyberNightVision">
    <description>你擁有黑暗視覺。</description>
  </ability>
  <ability Command="CommandToggleNocturnalApex">
    <description><p>在 <stat Name="Duration" /> 回合內，獲得 +<stat Name="AgilityBonus" /> 敏捷與 +<stat Name="MovespeedBonus" /> 移動速度。</p>
<br />
<statline Name="Cooldown" DisplayName="冷卻時間" /></description>
  </ability>
  <ability Command="CommandActivateOnboardRecoilerImprinting">
