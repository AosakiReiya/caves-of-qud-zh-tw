<br />
<statline Name="Duration" DisplayName="Duration" />
<statline Name="Cooldown" DisplayName="冷卻時間" /></description>
  </ability>
  <ability Command="ActivateStopsvalinn">
    <description><p>你產生一道力牆來阻礙機器人的移動。</p>
<br />
